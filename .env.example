# Server Configuration
SERVER_PORT=8080
SERVER_CONTEXT_PATH=/procucev
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=procucev_v1
DB_USERNAME=root
DB_PASSWORD=your_password
DB_URL=jdbc:mysql://${DB_HOST}:${DB_PORT}/${DB_NAME}?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC

# Security & JWT Configuration
JWT_SECRET=your_super_secret_key_that_is_at_least_32_chars_long
APP_OAUTH2_CLIENT_ID=procucev
APP_OAUTH2_CLIENT_SECRET=secret123

# Mail Server Configuration
# Four separate Google accounts are used, so each needs its own app password.
# An app password is only valid for the account it was generated for: reusing one
# across mailboxes fails authentication at send/poll time, not at startup.
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=rfq@procucev.com
SPRING_MAIL_PASSWORD=your_app_password
SPRING_MAIL_FROM="Procucev Admin"
RFQ_ACKNOWLEDGEMENT_FROM=rfq@procucev.com
RFQ_ACKNOWLEDGEMENT_CC=support@procucev.com

# GMT mailbox (gmtrfq@procucev.com) - vendor enquiries and the quotation forwarder.
# Leave unset only if the GMT email flow is intentionally disabled.
QUA_EMAIL_PASSWORD=gmtrfq_app_password

# Invitations mailbox (invitations@procucev.com) - verification and invite mails.
MAIL_PASSWORD=invitations_app_password

# Email-to-RFQ pipeline inbox (IMAP poller).
EMAIL_USERNAME=rfq@procucev.com
EMAIL_PASSWORD=rfq_app_password

# External Integrations (Zoho / SMS)
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token
SMS_API_URL=https://sms.sendmsg.in/datasend
SMS_API_AUTHKEY=your_sms_auth_key

# Gemini AI Configuration (RFQ Extraction & Key Rotation)
# Supports a single API key or a comma-separated list of keys (key1,key2,key3) for round-robin rotation across free tier rate limits.
# Can also be provided via GEMINI_API_KEYS.
GEMINI_API_KEY=your_gemini_api_key_or_comma_separated_keys
# GEMINI_API_KEYS=key1,key2,key3
GEMINI_PRIMARY_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_EXTRACTION_MAX_ATTEMPTS=3

# Scheduled Jobs
JOBS_ENABLED=true

